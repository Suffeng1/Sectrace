{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["schema_version","dataset_version","cases"],"properties":{"schema_version":{"const":"1.0"},"dataset_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"cases":{"type":"array","minItems":5,"items":{"$ref":"#/$defs/case"}}},"$defs":{"case":{"type":"object","additionalProperties":false,"required":["case_id","trace_id","source_scenarios","case_kind","provenance","corroboration","approval","ledger","oracle"],"properties":{"case_id":{"type":"string","pattern":"^[a-z0-9-]+$"},"trace_id":{"type":"string","pattern":"^[a-z0-9-]+$"},"source_scenarios":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^S(?:0[1-9]|1[0-9]|2[0-4])$"}},"case_kind":{"enum":["normal","insufficient","conflicting","invalid_approval","tampered_ledger"]},"provenance":{"type":"object","additionalProperties":false,"required":["source_count","same_subject","ordered_risk_sequence"],"properties":{"source_count":{"type":"integer","minimum":1},"same_subject":{"type":"boolean"},"ordered_risk_sequence":{"type":"boolean"}}},"corroboration":{"type":"object","additionalProperties":false,"required":["state","contradictory_claims"],"properties":{"state":{"enum":["strong","insufficient","conflicting"]},"contradictory_claims":{"type":"boolean"}}},"approval":{"type":"object","additionalProperties":false,"required":["required","decision","binding_valid"],"properties":{"required":{"type":"boolean"},"decision":{"enum":["approved","not_requested"]},"binding_valid":{"type":["boolean","null"]}}},"ledger":{"type":"object","additionalProperties":false,"required":["tampered"],"properties":{"tampered":{"type":"boolean"}}},"oracle":{"type":"object","additionalProperties":false,"required":["risk_level","terminal","branch_gate"],"properties":{"risk_level":{"enum":["low","high",null]},"terminal":{"enum":["qualified","rejected","not_qualified","expected_fail_closed"]},"branch_gate":{"enum":["a