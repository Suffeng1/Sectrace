{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "dataset_version", "case_results", "metrics", "summary"],
  "properties": {
    "schema_version": {"const": "1.0"}, "dataset_version": {"type": "string"},
    "case_results": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/case_result"}},
    "metrics": {"type": "array", "minItems": 8, "maxItems": 8, "prefixItems": [
      {"$ref":"#/$defs/scenario_run_rate"}, {"$ref":"#/$defs/expected_risk_terminal_accuracy"}, {"$ref":"#/$defs/trace_continuity_rate"}, {"$ref":"#/$defs/stage_order_validity_rate"}, {"$ref":"#/$defs/approval_binding_rate"}, {"$ref":"#/$defs/ledger_integrity_rate"}, {"$ref":"#/$defs/fail_closed_rejection_rate"}, {"$ref":"#/$defs/branch_gate_accuracy"}
    ], "items": false},
    "summary": {"type":"object", "additionalProperties":false, "required":["passed","failed","exit_code"], "properties":{"passed":{"type":"integer","minimum":0,"maximum":8},"failed":{"type":"integer","minimum":0,"maximum":8},"exit_code":{"enum":[0,1]}}}
  },
  "$defs": {
    "case_result": {"type":"object", "additionalProperties":false, "required":["case_id","case_kind","trace_id","execution_status","capability_boundary","scenario_run","scenario_applicable","risk_level","terminal","risk_terminal","trace_applicable","trace_continuity","stage_order","approval_applicable","approval_binding","approval_probe_results","ledger_applicable","ledger_integrity","fail_closed_applicable","fail_closed","branch_gate"], "properties":{"case_id":{"type":"string"},"case_kind":{"type":"string"},"trace_id":{"type":["string","null"]},"execution_status":{"enum":["executed","expected_fail_closed"]},"capability_boundary":{"type":"boolean"},"scenario_run":{"type":"boolean"},"scenario_applicable":{"type":"boolean"},"risk_level":{"enum":["low","high",null]},"terminal":{"enum":["qualified","rejected","not_qualified","expected_fail_closed"]},"risk_terminal":{"type":"boolean"},"trace_applicable":{"type":"boolean"},"trace_continuity":{"type":"boolean"},"stage_order":{"type":"boolean"},"approval_applicable":{"type":"boolean"},"approval_binding":{"type":"boolean"},"approval_probe_results":{"type":"array","items":{"enum":["wrong_trace","wrong_plan","wrong_decision","unbound_event"]}},"ledger_applicable":{"type":"boolean"},"ledger_integrity":{"type":"boolean"},"fail_closed_applicable":{"type":"boolean"},"fail_closed":{"type":"boolean"},"branch_gate":{"type":"boolean"}}},
    "metric": {"type":"object", "additionalProperties":false, "required":["name","applicable_cases","numerator","denominator","zero_denominator_policy","evidence_source","failure_class","aggregation","passed"], "properties":{"name":{"type":"string"},"applicable_cases":{"type":"array","items":{"type":"string"}},"numerator":{"type":"integer","minimum":0},"denominator":{"type":"integer","minimum":0},"zero_denominator_policy":{"enum":["fail","not_applicable_pass"]},"evidence_source":{"type":"string"},"failure_class":{"type":"string"},"aggregation":{"enum":["case","unique_trace"]},"passed":{"type":"boolean"}}},
    "scenario_run_rate":{"allOf":[{"$ref":"#/$defs/metric"},{"properties":{"name":{"const":"scenario_run_rate"}}}]}, "expected_risk_terminal_accuracy":{"allOf":[{"$ref":"#/$defs/metric"},{"properties":{"name":{"const":"expected_risk_terminal_accuracy"}}}]}, "trace_continuity_rate":{"allOf":[{"$ref":"#/$defs/metric"},{"properties":{"name":{"const":"trace_continuity_rate"}}}]}, "stage_order_validity_rate":{"allOf":[{"$ref":"#/$defs/metric"},{"properties":{"name":{"const":"stage_order_validity_rate"}}}]}, "approval_binding_rate":{"allOf":[{"$ref":"#/$defs/metric"},{"properties":{"name":{"const":"approval_binding_rate"}}}]}, "ledger_integrity_rate":{"allOf":[{"$ref":"#/$defs/metric"},{"properties":{"name":{"const":"ledger_integrity_rate"}}}]}, "fail_closed_rejection_rate":{"allOf":[{"$ref":"#/$defs/metric"},{"properties":{"name":{"const":"fail_closed_rejection_rate"}}}]}, "branch_gate_accuracy":{"allOf":[{"$ref":"#/$defs/metric"},{"properties":{"name":{"const":"branch_gate_accuracy"}}}]}
  }
}
