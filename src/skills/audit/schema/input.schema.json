{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sectrace.local/skills/audit/1.0.0/input.schema.json",
  "type": "object",
  "required": ["incident", "evidence_items", "response_plan", "approval", "ledger_records"],
  "properties": {
    "incident": {"$ref": "#/$defs/incident"},
    "evidence_items": {"type": "array", "minItems": 0, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
    "response_plan": {"anyOf": [{"$ref": "#/$defs/response"}, {"type": "null"}]},
    "approval": {"anyOf": [{"$ref": "#/$defs/approval"}, {"type": "null"}]},
    "ledger_records": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/ledger"}}
  },
  "additionalProperties": false,
  "$defs": {
    "trace": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 512},
    "incident": {"type": "object", "required": ["trace_id", "schema_version", "scenario_id", "severity_hint", "raw_event_refs", "tasks", "status"], "properties": {"trace_id": {"$ref": "#/$defs/trace"}, "schema_version": {"const": "1.0"}, "scenario_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"}, "severity_hint": {"enum": ["low", "medium", "high"]}, "raw_event_refs": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}, "tasks": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["collect_evidence", "plan_response", "audit"]}}, "status": {"enum": ["open", "analyzing", "awaiting_approval", "closed"]}}, "additionalProperties": false},
    "evidence": {"type": "object", "required": ["evidence_id", "trace_id", "source_ref", "statement", "classification", "confidence", "evidence_level", "related_event_refs"], "properties": {"evidence_id": {"$ref": "#/$defs/identifier"}, "trace_id": {"$ref": "#/$defs/trace"}, "source_ref": {"$ref": "#/$defs/identifier"}, "statement": {"$ref": "#/$defs/text"}, "classification": {"enum": ["fact", "inference", "unknown"]}, "confidence": {"enum": ["low", "medium", "high"]}, "evidence_level": {"enum": ["insufficient", "corroborated", "strong"]}, "related_event_refs": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}}, "additionalProperties": false},
    "response": {"type": "object", "required": ["plan_id", "trace_id", "risk_level", "actions", "verification_steps", "rollback_steps", "requires_approval", "status"], "properties": {"plan_id": {"$ref": "#/$defs/identifier"}, "trace_id": {"$ref": "#/$defs/trace"}, "risk_level": {"enum": ["low", "medium", "high"]}, "actions": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/text"}}, "verification_steps": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/text"}}, "rollback_steps": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/text"}}, "requires_approval": {"type": "boolean"}, "status": {"enum": ["draft", "pending_approval", "executed"]}}, "additionalProperties": false},
    "approval": {"type": "object", "required": ["trace_id", "approver_role", "status", "timestamp"], "properties": {"trace_id": {"$ref": "#/$defs/trace"}, "approver_role": {"const": "human_operator"}, "status": {"enum": ["not_requested", "pending", "approved", "rejected"]}, "timestamp": {"type": ["string", "null"], "format": "date-time"}}, "additionalProperties": false},
    "ledger": {"type": "object", "required": ["event_id", "trace_id", "at", "actor", "event_type", "payload_ref", "prev_hash", "hash"], "properties": {"event_id": {"$ref": "#/$defs/identifier"}, "trace_id": {"$ref": "#/$defs/trace"}, "at": {"type": "string", "format": "date-time"}, "actor": {"$ref": "#/$defs/identifier"}, "event_type": {"$ref": "#/$defs/identifier"}, "payload_ref": {"type": "string", "minLength": 1, "maxLength": 512}, "prev_hash": {"type": "string", "pattern": "^(|[a-f0-9]{64})$"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}
  }
}
