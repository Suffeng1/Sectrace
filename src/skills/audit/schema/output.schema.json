{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://sectrace.local/skills/audit/1.0.0/output.schema.json","type":"object","required":["trace_id","evidence_refs","response_plan_ref","approval_ref","missing_requirements","report_markdown","ledger_hash","audit_status","integrity_check"],"properties":{"trace_id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},"evidence_refs":{"type":"array","maxItems":16,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"}},"response_plan_ref":{"type":["string","null"],"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},"approval_ref":{"type":["string","null"],"maxLength":32,"pattern":"^approval:(?:not_requested|pending|approved|rejected)$"},"missing_requirements":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":160}},"report_markdown":{"type":"string","minLength":1,"maxLength":4096},"ledger_hash":{"type":"string","pattern":"^(|[a-f0-9]{64})$"},"audit_status":{"enum":["qualified","qualified_with_gaps","not_qualified"]},"integrity_check":{"enum":["passed","failed"]}},"additionalProperties":false}
